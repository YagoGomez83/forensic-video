POSTGRES_PASSWORD=cambiar

# Clave HMAC de los JWT, de al menos 32 bytes. Generala con: openssl rand -base64 48
JWT_CLAVE_DE_FIRMA=

# Seed del primer admin: sólo se usa si todavía no existe ningún admin activo, y debe cambiar la
# contraseña en su primer acceso. Una vez creado, borrá estas dos líneas.
ADMIN_INICIAL_USUARIO=
ADMIN_INICIAL_CONTRASENA=
