POSTGRES_PASSWORD=cambiar

# Clave HMAC de los JWT, de al menos 32 bytes. Generala con: openssl rand -base64 48
JWT_CLAVE_DE_FIRMA=

# Seed del primer admin: sólo se usa si todavía no existe ningún admin activo, y debe cambiar la
# contraseña en su primer acceso. Una vez creado, borrá estas dos líneas.
ADMIN_INICIAL_USUARIO=
ADMIN_INICIAL_CONTRASENA=

# Clave Ed25519 del laboratorio para sellar la cadena de custodia: el secreto crítico del sistema.
# Generala FUERA del repo y guardá un respaldo offline; quien la tenga puede firmar sellos.
#   openssl genpkey -algorithm ed25519 -out /ruta/segura/clave-sellado.pem
#   chown 1654 /ruta/segura/clave-sellado.pem && chmod 400 /ruta/segura/clave-sellado.pem   (1654 = usuario app)
# Huella que se publica por otro medio para que un tercero verifique los sellos (= ClaveId sin "ed25519:"):
#   openssl pkey -in /ruta/segura/clave-sellado.pem -pubout -outform DER | tail -c 32 | sha256sum
CLAVE_SELLADO_ARCHIVO=
