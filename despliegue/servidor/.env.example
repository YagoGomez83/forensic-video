# Producción: copiar a despliegue/servidor/.env (está en .gitignore) y completar. Todas las rutas, FUERA
# del repo. Las carpetas de datos son del usuario 1654 (app) del contenedor del servidor:
#   mkdir -p <ruta> && chown 1654:1654 <ruta> && chmod 700 <ruta>

# Interfaz del host donde escucha el servidor (la de la red del laboratorio, no 0.0.0.0 si se puede evitar).
IP_SERVIDOR=
PUERTO_SERVIDOR=8443

# Generala con: openssl rand -base64 32
POSTGRES_PASSWORD=
# Carpeta de datos de PostgreSQL (la gestiona el contenedor de postgres; no hace falta chown).
POSTGRES_DIR=

# Clave HMAC de los JWT, de al menos 32 bytes: openssl rand -base64 48
JWT_CLAVE_DE_FIRMA=

# Seed del primer admin: sólo se usa si todavía no existe ningún admin activo, y debe cambiar la
# contraseña en su primer acceso. Una vez creado, borrá estas dos líneas.
ADMIN_INICIAL_USUARIO=
ADMIN_INICIAL_CONTRASENA=

# Evidencia (originales y derivados, direccionados por hash) y sellos de la cadena. Los sellos, en otro
# disco o montaje donde el administrador de PostgreSQL no pueda escribir.
EVIDENCIA_DIR=
SELLOS_DIR=

# Clave Ed25519 del laboratorio (el secreto crítico; respaldo offline):
#   openssl genpkey -algorithm ed25519 -out /ruta/segura/clave-sellado.pem
#   chown 1654 /ruta/segura/clave-sellado.pem && chmod 400 /ruta/segura/clave-sellado.pem
# Huella a publicar por otro medio, para que un tercero verifique los sellos:
#   openssl pkey -in /ruta/segura/clave-sellado.pem -pubout -outform DER | tail -c 32 | sha256sum
CLAVE_SELLADO_ARCHIVO=

# Carpeta con ca.crt, servidor.crt y servidor.key (scripts/generar-certificados-mtls.sh); ca.key, offline.
#   chown 1654 /ruta/segura/tls/servidor.key
TLS_DIR=
