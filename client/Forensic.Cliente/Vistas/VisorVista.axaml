<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forensic.Cliente.Nucleo.Visor"
             xmlns:c="using:Forensic.Cliente.Controles"
             x:Class="Forensic.Cliente.Vistas.VisorVista"
             x:DataType="vm:VisorViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="12" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="← Caso" Command="{Binding VolverCommand}" />
        <Button Content="Linaje y reproducción" Command="{Binding VerLinajeCommand}" />
        <TextBlock Text="{Binding Evidencia.NombreOriginal}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Evidencia.Via}" VerticalAlignment="Center" Opacity="0.8" />
        <TextBlock Text="{Binding Transformacion.Zoom, StringFormat='Zoom {0:P0}'}" VerticalAlignment="Center" Opacity="0.7" />
      </StackPanel>
      <TextBlock Text="{Binding Evidencia.Hash, StringFormat='SHA-256 {0}'}" FontFamily="Consolas,Menlo,monospace" FontSize="11" Opacity="0.7" />
      <TextBlock Text="{Binding OperacionDeOrigen, StringFormat='Derivado de: {0}'}" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                 IsVisible="{Binding OperacionDeOrigen, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Text="Rueda: zoom · botón derecho: mover · botón izquierdo: marcar una región" Opacity="0.6" FontSize="12" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock VerticalAlignment="Center"
                   Text="{Binding RegionMarcada, StringFormat='Región (píxeles de la imagen): {0}', TargetNullValue='Sin región marcada'}" />
        <Button x:Name="AplicarRecorte" Content="Aplicar recorte" Command="{Binding AplicarRecorteCommand}" />
        <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding Aplicando}" />
      </StackPanel>
      <TextBlock Classes="aviso" Text="{Binding SinPrevisualizacion}" IsVisible="{Binding SinPrevisualizacion, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
    <Border Background="#202020">
      <c:LienzoDeEvidencia x:Name="Lienzo" Transformacion="{Binding Transformacion}" Region="{Binding RegionMarcada}" />
    </Border>
  </DockPanel>
</UserControl>
