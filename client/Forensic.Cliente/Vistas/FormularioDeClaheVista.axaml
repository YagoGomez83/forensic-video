<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:op="using:Forensic.Cliente.Nucleo.Operaciones"
             x:Class="Forensic.Cliente.Vistas.FormularioDeClaheVista"
             x:DataType="op:FormularioDeClahe">
  <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBlock Text="Límite de contraste:" VerticalAlignment="Center" />
    <NumericUpDown Width="120" Increment="0.5" FormatString="0.#" Value="{Binding Limite}" />
    <TextBlock Text="Cuadrícula (celdas por lado):" VerticalAlignment="Center" />
    <NumericUpDown Width="110" Increment="1" FormatString="0" Value="{Binding Cuadricula}" />
  </StackPanel>
</UserControl>
