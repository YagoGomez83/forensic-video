<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:op="using:Forensic.Cliente.Nucleo.Operaciones"
             x:Class="Forensic.Cliente.Vistas.FormularioDeRotacion90Vista"
             x:DataType="op:FormularioDeRotacion90">
  <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBlock Text="Cuartos de vuelta en sentido horario:" VerticalAlignment="Center" />
    <ComboBox ItemsSource="{x:Static op:FormularioDeRotacion90.OpcionesDeGiros}" SelectedItem="{Binding Giros}" />
    <TextBlock Text="(1 = 90°, 2 = 180°, 3 = 270°)" VerticalAlignment="Center" Opacity="0.7" />
  </StackPanel>
</UserControl>
