<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:op="using:Forensic.Cliente.Nucleo.Operaciones"
             x:Class="Forensic.Cliente.Vistas.FormularioDeUnsharpVista"
             x:DataType="op:FormularioDeUnsharp">
  <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBlock Text="Sigma:" VerticalAlignment="Center" />
    <NumericUpDown Width="120" Increment="0.1" FormatString="0.##" Value="{Binding Sigma}" />
    <TextBlock Text="Cantidad:" VerticalAlignment="Center" />
    <NumericUpDown Width="120" Increment="0.1" FormatString="0.##" Value="{Binding Cantidad}" />
  </StackPanel>
</UserControl>
