<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:op="using:Forensic.Cliente.Nucleo.Operaciones"
             x:Class="Forensic.Cliente.Vistas.FormularioDePerspectivaVista"
             x:DataType="op:FormularioDePerspectiva">
  <StackPanel Spacing="6">
    <TextBlock Opacity="0.8" TextWrapping="Wrap"
               Text="Hacé clic en los 4 puntos, en orden: superior izquierdo, superior derecho, inferior derecho, inferior izquierdo." />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Salida (px):" VerticalAlignment="Center" />
      <NumericUpDown Width="130" Minimum="1" Increment="1" FormatString="0" Value="{Binding Ancho}" Watermark="ancho" />
      <TextBlock Text="×" VerticalAlignment="Center" />
      <NumericUpDown Width="130" Minimum="1" Increment="1" FormatString="0" Value="{Binding Alto}" Watermark="alto" />
      <TextBlock Text="Interpolación:" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{x:Static op:Interpolaciones.Todas}" SelectedItem="{Binding Interpolacion}" />
    </StackPanel>
  </StackPanel>
</UserControl>
