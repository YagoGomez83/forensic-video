<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forensic.Cliente.Nucleo.Visor"
             xmlns:api="using:Forensic.Cliente.Api"
             x:Class="Forensic.Cliente.Vistas.LinajeVista"
             x:DataType="vm:LinajeViewModel">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="← Visor" Command="{Binding VolverCommand}" />
        <TextBlock Text="{Binding Evidencia.NombreOriginal, StringFormat='Linaje de {0}'}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="Reproducir" Content="Reproducir desde el asiento" Command="{Binding ReproducirCommand}" />
        <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding Reproduciendo}" />
      </StackPanel>
      <TextBlock x:Name="Veredicto" Text="{Binding Veredicto}" TextWrapping="Wrap" FontWeight="SemiBold"
                 Classes.error="{Binding Reproducido, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:False}}"
                 IsVisible="{Binding Veredicto, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
    <ListBox Margin="0,12,0,0" ItemsSource="{Binding Eslabones}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="api:EslabonDeLinaje">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Evidencia.NombreOriginal}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Evidencia.Via}" Opacity="0.8"
                       Classes.soloInvestigacion="{Binding Evidencia.Via, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static api:ViaProcesamiento.SoloInvestigacion}}" />
            <TextBlock Text="{Binding Evidencia.Hash, StringFormat='SHA-256 {0}'}" FontFamily="Consolas,Menlo,monospace" FontSize="11" Opacity="0.7" />
            <TextBlock Text="Original ingestado" Opacity="0.7" IsVisible="{Binding Operacion, Converter={x:Static ObjectConverters.IsNull}}" />
            <StackPanel IsVisible="{Binding Operacion, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="2">
              <TextBlock FontFamily="Consolas,Menlo,monospace" FontSize="12">
                <Run Text="{Binding Operacion.Tipo}" />
                <Run Text=" " />
                <Run Text="{Binding Operacion.Parametros}" />
              </TextBlock>
              <TextBlock Text="{Binding Operacion.Entorno, StringFormat='Entorno: {0}'}" FontFamily="Consolas,Menlo,monospace" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Operacion.Actor, StringFormat='Aplicada por {0}'}" Opacity="0.7" />
              <TextBlock Text="{Binding Reproducciones.Count, StringFormat='Reproducciones asentadas: {0}'}" Opacity="0.7" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
