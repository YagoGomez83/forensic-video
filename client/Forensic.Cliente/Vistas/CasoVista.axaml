<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Forensic.Cliente.Nucleo.Casos"
             xmlns:api="using:Forensic.Cliente.Api"
             x:Class="Forensic.Cliente.Vistas.CasoVista"
             x:DataType="vm:CasoViewModel">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="← Casos" Command="{Binding VolverCommand}" />
        <TextBlock Text="{Binding Caso.NumeroExpediente}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Caso.Estado}" VerticalAlignment="Center" Opacity="0.7" />
      </StackPanel>
      <TextBlock Text="{Binding Caso.Descripcion}" TextWrapping="Wrap" />
      <TextBlock x:Name="EstadoDeLaCadena" Text="{Binding EstadoDeLaCadena}" FontWeight="SemiBold"
                 Classes.error="{Binding !CadenaIntegra}" />
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
    <Grid ColumnDefinitions="*,8,*" Margin="0,12,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Evidencias" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox x:Name="Evidencias" ItemsSource="{Binding Evidencias}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="api:EvidenciaDto">
              <StackPanel>
                <TextBlock Text="{Binding NombreOriginal}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Via}" Opacity="0.8" />
                <TextBlock Text="{Binding Hash, StringFormat='SHA-256 {0}'}" FontFamily="Consolas,Menlo,monospace" FontSize="11" Opacity="0.7" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="Cadena de custodia" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox x:Name="Asientos" ItemsSource="{Binding Asientos}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="api:AsientoDto">
              <Grid ColumnDefinitions="40,*,Auto">
                <TextBlock Text="{Binding Secuencia}" />
                <TextBlock Grid.Column="1" Text="{Binding Tipo}" />
                <TextBlock Grid.Column="2" Text="{Binding Actor}" Opacity="0.7" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
