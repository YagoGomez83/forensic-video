<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:op="using:Forensic.Cliente.Nucleo.Operaciones"
             x:Class="Forensic.Cliente.Vistas.FormularioDeDenoiseMedianaVista"
             x:DataType="op:FormularioDeDenoiseMediana">
  <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBlock Text="Ventana (impar):" VerticalAlignment="Center" />
    <NumericUpDown Width="110" Increment="2" FormatString="0" Value="{Binding Ventana}" />
  </StackPanel>
</UserControl>
