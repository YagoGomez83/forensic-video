<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- La versión se ve en el título y al comprobar la configuración. Un release la reemplaza por «v1.2.3-<commit>»
         (release-cliente.yml); en desarrollo queda esta, más el commit que agrega el SDK. -->
    <Version>0.0.0-desarrollo</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Forensic.Cliente.Nucleo\Forensic.Cliente.Nucleo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Forensic.Cliente.Tests" />
  </ItemGroup>

</Project>
