<Project>
  <!-- El cliente para las workstations (release-cliente.yml): una carpeta con el runtime de .NET incluido,
       así que no hace falta instalar nada. Sin single-file: con Avalonia extrae las bibliotecas nativas
       de Skia a %TEMP% al arrancar. Sin trimming: los bindings y el localizador de vistas usan reflexión,
       y lo que el trimmer quita sólo falla al abrir la pantalla que lo usa. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildProjectDirectory)\bin\publicado\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
